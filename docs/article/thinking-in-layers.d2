...@_style

direction: right

title: "Night · someone walks in · no button pressed · no alarm" {class: title}

footer: "order is priority: later layers win  ───────────────▶" {class: footer}

default: "default\noff" {
  shape: oval
}

motion: Motion {
  class: layer
  w: "watches:\nmotion sensor · sun" {class: watches}
  a: "motion, night\n→ night light" {class: [rule; active]}
  b: "motion, day\n→ bright" {class: rule}
  c: "no motion\n→ pass through" {class: [rule; pass]}
}

switch: Dimmer switch {
  class: layer
  w: "watches:\nbutton presses" {class: watches}
  a: "on pressed\n→ bright / off" {class: rule}
  b: "scene pressed\n→ next scene" {class: rule}
  c: "not touched\n→ pass through" {class: [rule; pass; active]}
}

alarm: Alarm {
  class: layer
  w: "watches:\nalarm panel" {class: watches}
  a: "triggered\n→ red" {class: rule}
  b: "otherwise\n→ pass through" {class: [rule; pass; active]}
}

light: "light.hallway_light" {
  style.double-border: true
  style.font-size: 16
  style.bold: true
}

default -> motion: off {class: value}
motion -> switch: night light {class: value}
switch -> alarm: night light {class: value}
alarm -> light: night light {class: value}
