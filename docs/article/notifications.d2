...@_style

direction: right

title: "Evening · relax scene picked earlier · doorbell rings" {class: title}

footer: "raised from other apps, without knowing\nwhich lights or pipelines exist" {class: footer}

default: "default\noff" {
  shape: oval
}

interaction: Interaction node {
  class: layer
  w: "watches:\nwall switch · the light itself" {class: watches}
  a: "wall switch\n→ ambiance / relax\n/ bright / off" {class: [rule; active]}
  b: "turned off by hand\n→ hold off" {class: rule}
  c: "otherwise\n→ pass through" {class: [rule; pass]}
}

notifications: Notifications node {
  class: layer
  w: "watches: active notifications\nhighest priority wins" {class: watches}
  a: "alarm app (100)\n→ red" {class: rule}
  b: "doorbell app (10)\n→ blink blue and white" {class: [rule; active]}
  c: "washing machine app (1)\n→ its own node" {class: rule}
  d: "none active\n→ pass through" {class: [rule; pass]}
}

light: "light.living_room_lights" {
  style.double-border: true
  style.font-size: 16
  style.bold: true
}

default -> interaction: off {class: value}
interaction -> notifications: relax {class: value}
notifications -> light: blue / white {class: value}
