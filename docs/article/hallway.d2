...@_style

direction: right

title: "Day · nobody in the hallway · wall switch pressed" {class: title}

default: "default\noff" {
  shape: oval
}

motion: Motion {
  class: layer
  w: "watches: HallwayMotionSensor · night" {class: watches}
  a: "motion, night  →  night light" {class: rule}
  b: "motion, day  →  bright" {class: rule}
  c: "no motion  →  pass through" {class: [rule; pass; active]}
}

interaction: Interaction node {
  class: layer
  w: "watches: wall switch · the light itself" {class: watches}
  a: "switch, light off  →  bright for 5 min, then pass through" {class: [rule; active]}
  b: "switch, light on  →  off until motion changes" {class: rule}
  c: "turned off by hand  →  hold off" {class: rule}
  d: "otherwise  →  pass through" {class: [rule; pass]}
}

light: "light.hallway_light" {
  style.double-border: true
  style.font-size: 16
  style.bold: true
}

default -> motion: off {class: value}
motion -> interaction: off {class: value}
interaction -> light: bright {class: value}
