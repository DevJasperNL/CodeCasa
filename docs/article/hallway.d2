...@_style

direction: right

title: "Day · nobody in the hallway · wall switch pressed" {class: title}

default: "default\noff" {
  shape: oval
}

motion: Motion {
  class: layer
  w: "watches:\nHallwayMotionSensor · night" {class: watches}
  a: "motion, night\n→ night light" {class: rule}
  b: "motion, day\n→ bright" {class: rule}
  c: "no motion\n→ pass through" {class: [rule; pass; active]}
}

interaction: Interaction node {
  class: layer
  w: "watches:\nwall switch · the light itself" {class: watches}
  a: "switch, light off\n→ bright for 5 min,\nthen pass through" {class: [rule; active]}
  b: "switch, light on\n→ off until motion changes" {class: rule}
  c: "turned off by hand\n→ hold off" {class: rule}
  d: "otherwise\n→ pass through" {class: [rule; pass]}
}

light: "light.hallway_light" {
  style.double-border: true
  style.font-size: 16
  style.bold: true
}

default -> motion: off {class: value}
motion -> interaction: off {class: value}
interaction -> light: bright {class: value}
